# Security headers for every page (Netlify). A full Content-Security-Policy
# follows the backend, once every script, image and media origin is known.
# No page may be framed, with one exception: /payment/return, which PesaPal
# loads inside our own PesaPal window; the edge function (netlify/edge-functions/share-card.js)
# relaxes framing to this site only, for that path alone. PesaPal's frame may use payments.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://pay.pesapal.com" "https://cybqa.pesapal.com"), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin-allow-popups
