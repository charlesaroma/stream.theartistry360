# Copy to .env.local. Vite only exposes VITE_ prefixed variables to the client.

# Empty means same-origin /api — the Netlify proxy in production, the Vite dev
# proxy locally. Set it only to address an API directly, e.g.
# https://api.theartistry360.com. No trailing slash; the /api/<version> prefix
# is added by src/store/tanstackStore/services/api/config.ts.
VITE_API_BASE_URL=
VITE_API_VERSION=v1
VITE_API_TIMEOUT=15000

# Mocks stay on until a service is moved onto HTTP. Setting this to false
# before the backend serves a route breaks every page that reads it.
VITE_API_MOCKS=true

# The backend's Socket.IO origin for live cache updates (Studio edits,
# entitlements after payment), e.g. https://api.theartistry360.com (the client
# adds /public or /member). Empty keeps realtime off
# (docs/07-state-management.md, section 6).
VITE_REALTIME_URL=
